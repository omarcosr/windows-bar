{
  "name": "windows-bar",
  "module": "src/main.tsx",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "bun src/main.tsx",
    "dev": "bunx tarve dev src/main.tsx",
    "typecheck": "tsc --noEmit",
    "bench": "bun scripts/bench-ticks.ts",
    "build": "bun run build:txiki",
    "release": "bun scripts/release.ts",
    "dev:bun": "bunx tarve dev src/main.tsx",
    "dev:node": "bunx tarve dev src/main.tsx --runtime node",
    "build:txiki": "bunx tarve build src/main.tsx --runtime txiki --outfile dist/WindowsBar.exe",
    "build:bun": "bunx tarve build src/main.tsx --runtime bun --outfile dist/bun/WindowsBar.exe",
    "build:node": "bunx tarve build src/main.tsx --runtime node --outfile dist/node/WindowsBar.exe"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@tarve/core": "0.13.7"
  },
  "version": "0.5.0",
  "tarve": {
    "name": "WindowsBar",
    "appId": "WindowsBar.Dock",
    "description": "Barra de tarefas com widgets para o Windows 11",
    "publisher": "omarcosr",
    "icon": "assets/icon.png",
    "installer": {
      "directory": "WindowsBar",
      "shortcutName": "WindowsBar",
      "languages": [
        "pt-BR",
        "en"
      ],
      "homepage": "https://github.com/omarcosr/windows-bar",
      "accent": "#0a84ff",
      "options": {
        "desktopShortcut": {
          "enabled": true,
          "default": false
        },
        "startup": {
          "enabled": true,
          "default": true,
          "command": [
            "--autostart",
            "on"
          ],
          "undo": [
            "--autostart",
            "off"
          ]
        },
        "launch": {
          "enabled": true,
          "default": true,
          "args": []
        }
      },
      "hooks": {
        "beforeInstall": [
          "--quit"
        ],
        "beforeUninstall": [
          [
            "--quit"
          ],
          [
            "--autostart",
            "off"
          ]
        ]
      }
    }
  }
}
